# Server & Security
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-secret
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (Optional — falls back to built-in memory store if omitted)
DB_HOST=localhost
DB_PORT=3306
DB_USER=tecump
DB_PASSWORD=
DB_NAME=tecump
DB_CONNECTION_LIMIT=10

# AI / Capabilities
GEMINI_API_KEY=

# Optional Email / Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TUMCU Christian Union <no-reply@tumcu.ac.ke>
NOTIFICATION_DISPATCH_INTERVAL_MS=30000
