{
  "name": "tecump-management-platform",
  "version": "1.0.0",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "type": "module",
  "description": "TUMCU Enterprise Christian Union Management Platform (TECUMP)",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "migrate": "tsx backend/src/database/migrate.ts",
    "db:migrate": "npm run migrate",
    "seed": "tsx backend/src/database/seed.ts",
    "create:admin": "tsx backend/src/database/create-admin.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@tanstack/react-query": "^5.67.2",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.8.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "motion": "^13.1.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.15",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.1",
    "uuid": "^11.1.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "pino-pretty": "^11.2.2",
    "postcss": "^8.5.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
